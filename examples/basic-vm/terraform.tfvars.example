# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to version control!

waldur_endpoint = "https://your-waldur-instance.com"
waldur_token    = "your-api-token-here"

project_name = "My Project Name"
vm_name      = "my-terraform-vm"
flavor_name  = "m1.small"
image_name   = "Ubuntu 22.04"
volume_size  = 20480  # 20 GB in MiB

# Find these UUIDs via Waldur API:
# curl -H "Authorization: Token YOUR_TOKEN" "https://waldur/api/marketplace-public-offerings/?type=OpenStack.Instance"
offering_uuid = "your-offering-uuid"

# curl -H "Authorization: Token YOUR_TOKEN" "https://waldur/api/openstack-volume-types/?tenant_uuid=TENANT_UUID"
volume_type_uuid = "your-volume-type-uuid"

# curl -H "Authorization: Token YOUR_TOKEN" "https://waldur/api/openstack-subnets/?tenant_uuid=TENANT_UUID"
subnet_uuid = "your-subnet-uuid"

# curl -H "Authorization: Token YOUR_TOKEN" "https://waldur/api/keys/"
ssh_key_uuid = "your-ssh-key-uuid"
